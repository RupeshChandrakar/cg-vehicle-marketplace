# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string. Matches docker-compose.yml for local dev.
DATABASE_URL="postgresql://cg_dev:cg_dev_password@localhost:5432/cg_vehicle_marketplace?schema=public"

# Optional: only needed for `prisma migrate diff --from-migrations` (advanced
# schema-diffing). `prisma migrate dev` manages its own shadow database
# automatically and does not need this.
# SHADOW_DATABASE_URL="postgresql://cg_dev:cg_dev_password@localhost:5432/cg_vehicle_marketplace_shadow?schema=public"

NODE_ENV=development
PORT=4000

# JWT signing secret for staff (admin/agent) auth. Generate a real random
# value for anything beyond local dev, e.g. `openssl rand -base64 48`.
JWT_SECRET=dev-only-secret-change-me
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

# Seeded local dev admin account (see prisma/seed.ts) — never use in production.
SEED_ADMIN_EMAIL=admin@cgautomarket.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# S3-compatible object storage for vehicle photos. Matches docker-compose.yml's
# MinIO service for local dev.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=cg_dev
STORAGE_SECRET_ACCESS_KEY=cg_dev_password
STORAGE_BUCKET=vehicle-media
# Public base URL used to build media links (MinIO console/API share a host in dev).
STORAGE_PUBLIC_URL=http://localhost:9000/vehicle-media

# Optional — agent reply-suggestion feature (Phase 5). Leave unset to use
# StubAiProvider (no real model calls, clearly-labeled placeholder drafts).
# ANTHROPIC_API_KEY=
