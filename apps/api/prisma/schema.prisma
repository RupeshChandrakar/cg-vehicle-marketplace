// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  // Lives under src/ (not a sibling apps/api/generated/) so the whole app
  // stays within one rootDir for tsc — otherwise the build output nests
  // under dist/src/main.js instead of the conventional dist/main.js.
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  customer
  agent
  admin

  @@map("user_role")
}

enum VehicleStatus {
  draft
  submitted
  under_review
  approved
  live
  rejected
  reserved
  sold
  expired

  @@map("vehicle_status")
}

enum FuelType {
  petrol
  diesel
  electric
  cng
  lpg
  other

  @@map("fuel_type")
}

enum Transmission {
  manual
  automatic

  @@map("transmission")
}

enum VehicleCondition {
  excellent
  good
  fair

  @@map("vehicle_condition")
}

enum EnquiryChannel {
  chat
  call

  @@map("enquiry_channel")
}

/// open: just created. contacted: agent has reached the customer at least
/// once. negotiating: active back-and-forth. closed_won/closed_lost: the
/// enquiry is done, either as a sale or not.
enum EnquiryStatus {
  open
  contacted
  negotiating
  closed_won
  closed_lost

  @@map("enquiry_status")
}

/// There's no in-app telephony integration — this just records the outcome
/// of a call an agent made off-platform, for accountability.
enum CallOutcome {
  connected
  no_answer
  busy
  wrong_number
  scheduled_callback

  @@map("call_outcome")
}

enum MessageSenderType {
  customer
  agent

  @@map("message_sender_type")
}

/// `email`/`passwordHash` are only ever set for staff (agent/admin) —
/// customers authenticate by phone/OTP (Phase 4), never a password.
/// `refreshTokenHash` holds the hash of the current refresh token so a
/// stolen token on disk isn't directly usable, and login elsewhere can
/// invalidate the old session by overwriting it. `otpHash`/`otpExpiresAt`/
/// `otpAttempts` are the customer OTP login's server-side state — the OTP
/// itself is never stored in plaintext, mirroring `refreshTokenHash`.
model User {
  id               String    @id @default(uuid())
  phone            String    @unique
  name             String?
  role             UserRole  @default(customer)
  email            String?   @unique
  passwordHash     String?   @map("password_hash")
  refreshTokenHash String?   @map("refresh_token_hash")
  otpHash          String?   @map("otp_hash")
  otpExpiresAt     DateTime? @map("otp_expires_at")
  otpAttempts      Int       @default(0) @map("otp_attempts")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  vehiclesSold        Vehicle[]             @relation("VehicleSeller")
  vehicleVerifications VehicleVerification[] @relation("VehicleVerifier")

  enquiriesAsCustomer Enquiry[] @relation("EnquiryCustomer")
  enquiriesAsAgent    Enquiry[] @relation("EnquiryAgent")
  callLogs            CallLog[] @relation("CallLogAgent")

  favorites       Favorite[]
  notifications   Notification[]
  reviewsWritten  Review[]       @relation("ReviewAuthor")
  reviewsReceived Review[]       @relation("ReviewAgent")
  reelsCreated    Reel[]         @relation("ReelCreator")

  @@map("users")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  vehicles Vehicle[]

  @@map("categories")
}

/// A Chhattisgarh district. `latitude`/`longitude` is the district centroid,
/// used for nearest-district lookup when a customer shares their location —
/// see docs/ARCHITECTURE.md for why centroid-distance instead of a geocoding API.
model Location {
  id        String   @id @default(uuid())
  district  String
  state     String   @default("Chhattisgarh")
  slug      String   @unique
  latitude  Float
  longitude Float
  createdAt DateTime @default(now()) @map("created_at")

  vehicles Vehicle[]

  @@map("locations")
}

/// `publicId` is intentionally nullable: it's assigned from a Postgres
/// sequence only when a listing is approved (see migration SQL), so
/// abandoned drafts never burn a visible Vehicle ID. `id` is never exposed
/// to clients.
model Vehicle {
  id     String @id @default(uuid())
  slug   String

  publicId Int? @unique @map("public_id")

  title        String
  brand        String
  model        String
  year         Int
  price        Decimal          @db.Decimal(12, 2)
  kmDriven     Int              @map("km_driven")
  fuelType     FuelType         @map("fuel_type")
  transmission Transmission
  condition    VehicleCondition @default(good)
  description  String?

  /// Category-specific extras that don't earn their own column yet
  /// (e.g. tractor horsepower, truck load capacity).
  specs Json @default("{}")

  status          VehicleStatus @default(draft)
  rejectionReason String?       @map("rejection_reason")

  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id])

  locationId String   @map("location_id")
  location   Location @relation(fields: [locationId], references: [id])

  sellerId String @map("seller_id")
  seller   User   @relation("VehicleSeller", fields: [sellerId], references: [id])

  media        VehicleMedia[]
  verification VehicleVerification?
  enquiries    Enquiry[]
  favorites    Favorite[]
  reviews      Review[]
  reels        Reel[]
  pageViews    PageView[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, categoryId, locationId])
  @@map("vehicles")
}

/// `storageKey` is the object path inside the bucket, not a full URL —
/// keeps us free to change the bucket's public base URL (or move behind a
/// CDN later) without a data migration. The API resolves it to a URL when
/// serving a vehicle.
model VehicleMedia {
  id        String  @id @default(uuid())
  vehicleId String  @map("vehicle_id")
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  storageKey String @map("storage_key")
  sortOrder  Int    @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("vehicle_media")
}

/// Separate from `Vehicle.status`: status tracks the listing's publication
/// pipeline, this tracks the admin's sign-off that backs the verification
/// badge shown to customers.
model VehicleVerification {
  id      String  @id @default(uuid())
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  vehicleId String @unique @map("vehicle_id")

  verifiedBy     String? @map("verified_by")
  verifiedByUser User?   @relation("VehicleVerifier", fields: [verifiedBy], references: [id])

  verifiedAt DateTime @default(now()) @map("verified_at")
  notes      String?

  @@map("vehicle_verifications")
}

/// A customer's interest in a vehicle. Customers never get the seller's
/// contact directly (see docs/ARCHITECTURE.md) — every enquiry is
/// auto-assigned to whichever active agent currently has the fewest open
/// enquiries, and that agent mediates all further contact.
model Enquiry {
  id String @id @default(uuid())

  vehicleId String  @map("vehicle_id")
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  customerId String @map("customer_id")
  customer   User   @relation("EnquiryCustomer", fields: [customerId], references: [id])

  agentId String? @map("agent_id")
  agent   User?   @relation("EnquiryAgent", fields: [agentId], references: [id])

  channel EnquiryChannel
  status  EnquiryStatus  @default(open)
  message String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  conversation Conversation?
  callLogs     CallLog[]

  @@index([status, agentId])
  @@index([customerId])
  @@index([vehicleId])
  @@map("enquiries")
}

/// One per enquiry — split out from Enquiry so the message list can be
/// queried/paginated on its own.
model Conversation {
  id String @id @default(uuid())

  enquiryId String  @unique @map("enquiry_id")
  enquiry   Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  messages Message[]

  @@map("conversations")
}

model Message {
  id String @id @default(uuid())

  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// `senderId` is a `User.id` (customer or agent) — kept alongside
  /// `senderType` rather than resolved through a single polymorphic
  /// relation, since both sender kinds are already the same `User` model.
  senderType MessageSenderType @map("sender_type")
  senderId   String            @map("sender_id")

  body String

  createdAt DateTime @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// There's no in-app telephony integration yet — this just records the
/// outcome of a call an agent made off-platform, for accountability.
model CallLog {
  id String @id @default(uuid())

  enquiryId String  @map("enquiry_id")
  enquiry   Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  loggedById String @map("logged_by_id")
  loggedBy   User   @relation("CallLogAgent", fields: [loggedById], references: [id])

  outcome CallOutcome
  notes   String?

  calledAt DateTime @default(now()) @map("called_at")

  @@map("call_logs")
}

model Favorite {
  id String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  vehicleId String  @map("vehicle_id")
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, vehicleId])
  @@map("favorites")
}

enum NotificationType {
  enquiry_assigned
  enquiry_received
  new_message
  vehicle_approved
  vehicle_rejected

  @@map("notification_type")
}

/// A per-user feed, not role-restricted — customers, agents, and admins all
/// get rows here (e.g. "enquiry assigned to you" for an agent, "your
/// vehicle is live" for a customer/seller).
model Notification {
  id String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  NotificationType
  title String
  body  String

  /// Optional deep-link id (an enquiry or vehicle id, depending on `type`)
  /// — intentionally untyped rather than a FK, since it can point at more
  /// than one kind of entity.
  relatedId String? @map("related_id")

  isRead Boolean @default(false) @map("is_read")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@map("notifications")
}

/// Exactly one of vehicleId/agentId is set — enforced in ReviewsService, not
/// the DB, matching the project's existing "no premature complexity"
/// pattern for cross-field rules (e.g. VehicleSpecsDto). The `@@unique`
/// pairs are still real DB-level "no duplicate review" constraints: Postgres
/// doesn't count NULLs as duplicates, so a vehicle-review row (agentId
/// null) never collides with an agent-review row (vehicleId null).
model Review {
  id String @id @default(uuid())

  authorId String @map("author_id")
  author   User   @relation("ReviewAuthor", fields: [authorId], references: [id])

  vehicleId String?  @map("vehicle_id")
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  agentId String? @map("agent_id")
  agent   User?   @relation("ReviewAgent", fields: [agentId], references: [id])

  rating  Int
  comment String?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([authorId, vehicleId])
  @@unique([authorId, agentId])
  @@map("reviews")
}

enum ReelTemplate {
  classic
  ken_burns

  @@map("reel_template")
}

enum ReelStatus {
  processing
  completed
  failed

  @@map("reel_status")
}

/// There's no real social-platform integration (no Instagram/Facebook/
/// YouTube API calls) — this is a manual status an agent/admin sets after
/// posting the downloaded video themselves. See docs/ARCHITECTURE.md
/// "Phase 6 notes" for why that's a deliberate scope boundary, not an
/// oversight.
enum ReelPublishStatus {
  draft
  published
  scheduled

  @@map("reel_publish_status")
}

model Reel {
  id String @id @default(uuid())

  vehicleId String  @map("vehicle_id")
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  createdById String @map("created_by_id")
  createdBy   User   @relation("ReelCreator", fields: [createdById], references: [id])

  template ReelTemplate
  status   ReelStatus @default(processing)

  /// Bucket-relative keys, resolved to a URL only when serving — same
  /// pattern as VehicleMedia.storageKey. Both null while status is
  /// "processing"; both set once "completed".
  storageKey          String? @map("storage_key")
  thumbnailStorageKey String? @map("thumbnail_storage_key")
  durationSeconds     Float?  @map("duration_seconds")
  errorMessage        String? @map("error_message")

  publishStatus ReelPublishStatus @default(draft) @map("publish_status")
  /// Free text (e.g. "instagram") — not an enum, since this never drives
  /// real API behavior, only a label the agent chose.
  platform      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([vehicleId])
  @@index([status])
  @@map("reels")
}

/// One row per page load, fired fire-and-forget from the customer web app —
/// anonymous by design (sessionId is a client-generated UUID in
/// localStorage, no account/PII required). vehicleId is set only for vehicle
/// detail pages, enabling both site-wide unique-visitor counts
/// (COUNT(DISTINCT session_id)) and a per-vehicle "most viewed" leaderboard
/// from the same event stream.
model PageView {
  id String @id @default(uuid())

  sessionId String @map("session_id")
  path      String

  vehicleId String?  @map("vehicle_id")
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([sessionId])
  @@index([vehicleId])
  @@index([createdAt])
  @@map("page_views")
}
