// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  // Lives under src/ (not a sibling apps/api/generated/) so the whole app
  // stays within one rootDir for tsc — otherwise the build output nests
  // under dist/src/main.js instead of the conventional dist/main.js.
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  customer
  agent
  admin

  @@map("user_role")
}

enum VehicleStatus {
  draft
  submitted
  under_review
  approved
  live
  rejected
  reserved
  sold
  expired

  @@map("vehicle_status")
}

enum FuelType {
  petrol
  diesel
  electric
  cng
  lpg
  other

  @@map("fuel_type")
}

enum Transmission {
  manual
  automatic

  @@map("transmission")
}

enum VehicleCondition {
  excellent
  good
  fair

  @@map("vehicle_condition")
}

/// `email`/`passwordHash` are only ever set for staff (agent/admin) —
/// customers authenticate by phone/OTP (Phase 4), never a password.
/// `refreshTokenHash` holds the hash of the current refresh token so a
/// stolen token on disk isn't directly usable, and login elsewhere can
/// invalidate the old session by overwriting it.
model User {
  id               String   @id @default(uuid())
  phone            String   @unique
  name             String?
  role             UserRole @default(customer)
  email            String?  @unique
  passwordHash     String?  @map("password_hash")
  refreshTokenHash String?  @map("refresh_token_hash")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  vehiclesSold        Vehicle[]             @relation("VehicleSeller")
  vehicleVerifications VehicleVerification[] @relation("VehicleVerifier")

  @@map("users")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  vehicles Vehicle[]

  @@map("categories")
}

/// A Chhattisgarh district. `latitude`/`longitude` is the district centroid,
/// used for nearest-district lookup when a customer shares their location —
/// see docs/ARCHITECTURE.md for why centroid-distance instead of a geocoding API.
model Location {
  id        String   @id @default(uuid())
  district  String
  state     String   @default("Chhattisgarh")
  slug      String   @unique
  latitude  Float
  longitude Float
  createdAt DateTime @default(now()) @map("created_at")

  vehicles Vehicle[]

  @@map("locations")
}

/// `publicId` is intentionally nullable: it's assigned from a Postgres
/// sequence only when a listing is approved (see migration SQL), so
/// abandoned drafts never burn a visible Vehicle ID. `id` is never exposed
/// to clients.
model Vehicle {
  id     String @id @default(uuid())
  slug   String

  publicId Int? @unique @map("public_id")

  title        String
  brand        String
  model        String
  year         Int
  price        Decimal          @db.Decimal(12, 2)
  kmDriven     Int              @map("km_driven")
  fuelType     FuelType         @map("fuel_type")
  transmission Transmission
  condition    VehicleCondition @default(good)
  description  String?

  /// Category-specific extras that don't earn their own column yet
  /// (e.g. tractor horsepower, truck load capacity).
  specs Json @default("{}")

  status          VehicleStatus @default(draft)
  rejectionReason String?       @map("rejection_reason")

  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id])

  locationId String   @map("location_id")
  location   Location @relation(fields: [locationId], references: [id])

  sellerId String @map("seller_id")
  seller   User   @relation("VehicleSeller", fields: [sellerId], references: [id])

  media        VehicleMedia[]
  verification VehicleVerification?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, categoryId, locationId])
  @@map("vehicles")
}

/// `storageKey` is the object path inside the bucket, not a full URL —
/// keeps us free to change the bucket's public base URL (or move behind a
/// CDN later) without a data migration. The API resolves it to a URL when
/// serving a vehicle.
model VehicleMedia {
  id        String  @id @default(uuid())
  vehicleId String  @map("vehicle_id")
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  storageKey String @map("storage_key")
  sortOrder  Int    @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("vehicle_media")
}

/// Separate from `Vehicle.status`: status tracks the listing's publication
/// pipeline, this tracks the admin's sign-off that backs the verification
/// badge shown to customers.
model VehicleVerification {
  id      String  @id @default(uuid())
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  vehicleId String @unique @map("vehicle_id")

  verifiedBy     String? @map("verified_by")
  verifiedByUser User?   @relation("VehicleVerifier", fields: [verifiedBy], references: [id])

  verifiedAt DateTime @default(now()) @map("verified_at")
  notes      String?

  @@map("vehicle_verifications")
}
